{
  "name": "damas-spanish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "dev:victory": "vite --config vite.victory.config.ts --host 0.0.0.0",
    "test:victory:browser": "npm run build && node scripts/check-victory-browser.mjs",
    "test:drag:browser": "npm run build && node scripts/check-drag-browser.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "vite-plugin-pwa": "^1.1.0"
  }
}
